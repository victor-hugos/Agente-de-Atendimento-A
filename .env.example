# Chave da OpenAI (fica só no servidor, nunca vai para o navegador)
OPENAI_API_KEY=sk-...

# Modelo padrão: o "mini" mais atual com tool calling. Troque para comparar
# (ex.: gpt-5-mini é mais barato; gpt-4.1-mini não usa raciocínio e costuma ser mais rápido).
OPENAI_MODEL=gpt-5.4-mini

# Só para modelos com raciocínio (família gpt-5 / o-series): minimal | low | medium | high.
# Deixe vazio para modelos sem raciocínio (ex.: gpt-4.1-mini).
OPENAI_REASONING_EFFORT=low

# Quantas mensagens recentes vão para o modelo (memória curta)
HISTORY_LIMIT=8

# Preço por 1 milhão de tokens (USD), para estimar custo. Confira em https://openai.com/api/pricing/
PRICE_INPUT_PER_M=0.75
PRICE_OUTPUT_PER_M=4.50

PORT=3000
